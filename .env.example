# Copy to .env and fill in. .env is gitignored (.env*) — never commit real
# values. This template is the deliberate exception (see .gitignore): it holds
# no values, and is the only record of which variables the app needs.

# Postgres connection string. Local development uses the container in
# docker-compose.yml — `docker compose up -d`, then:
#   DATABASE_URL=postgresql://ondeck:ondeck@localhost:55432/ondeck
#
# Do not point this at the hosted database. Every machine runs a worker that
# claims recommendation jobs from the queue, so a local process will pick up
# and run real users' jobs, and local test rows get executed in production.
DATABASE_URL=

# The hosted database, kept under a name nothing reads so that touching
# production is deliberate rather than the default:
#   DATABASE_URL="$PRODUCTION_DATABASE_URL" npm run db:migrate
#
# To refresh local data from it (needs Docker, no local psql required):
#   docker run --rm postgres:17 pg_dump "$PRODUCTION_DATABASE_URL" \
#     --schema=public --no-owner --no-privileges > tmp/prod-dump.sql
#   docker compose exec -T postgres psql -U ondeck -d ondeck < tmp/prod-dump.sql
PRODUCTION_DATABASE_URL=

# Signs and encrypts the session cookie. Any long random string works;
# generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# TMDB v3 API key, used to search and import movies and TV.
# Get one free at https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# Anthropic API key, used to regenerate taste-profile summaries and generate
# recommendations. Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Books come from Google Books, used to search and import books. Create a key
# at https://console.cloud.google.com/ — APIs & Services > Library > enable
# "Books API", then Credentials > Create Credentials > API key. Restrict the
# key to the Books API so a leak can't be used for anything else.
#
# The Goodreads CSV importer (app/data/imports/goodreads.ts) still resolves
# ISBNs against Open Library instead, which needs no key — its batched OR
# query resolves hundreds of books in a handful of requests, which Google
# Books' quota doesn't comfortably allow.
GOOGLE_BOOKS_API_KEY=

# Steam Web API key, used to read a linked account's owned games for the
# library import. Free and instant at https://steamcommunity.com/dev/apikey
#
# One server-side key for the whole app, not per user — accounts are linked
# through Steam's OpenID flow, which needs no key. The key does not override
# privacy: a library only imports if that profile's game details are public.
STEAM_API_KEY=

# IGDB (Twitch), used to search and import video games. Create an app at
# https://dev.twitch.tv/console/apps — Client Type must be Confidential, or
# Twitch won't issue a secret and the token exchange below can't work. The
# OAuth Redirect URL the form insists on is never used: this is a
# client_credentials grant, which is server-to-server with no browser step.
# It must still be an HTTPS URL to pass validation.
#
# Unlike the other providers, these two aren't sent to the API. They're
# exchanged with id.twitch.tv for a bearer token (~60 days) that the app
# caches and renews itself.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Syncing a member's Letterboxd diary from their public RSS feed, on top of the
# one-time CSV import — set to 1 or true to open it to everyone. Opt-in on
# purpose: leaving it unset in production hides the feature, so shipping it
# takes a deliberate act rather than a forgotten one.
#
# Admins have it either way (users.is_admin, granted by scripts/set-admin.ts),
# so it can be exercised against production before it is turned on for everyone.
# Leaving this unset is therefore the beta, not the off switch.
#
# The whole feature hangs off the same gate, so it stops the outbound requests
# and not just the UI. A member already connected when it closes keeps their
# username on their row, dormant, and starts syncing again when it opens.
LETTERBOXD_FEED_SYNC=

# Lets a sync remove log rows for diary entries that are no longer in the feed —
# set to 1 or true. Separate from the flag above and off by default: this is the
# only part of the sync that destroys anything, and there is nothing to restore
# a row from afterwards.
#
# Left unset, the sync still works out which rows it would remove and logs them
# by title. That is the intended way to run it first — the reports can be read
# against a real diary to confirm it would have taken the right ones, without
# betting anyone's log on it.
#
# Only rows the feed itself created are ever eligible (source = 'letterboxd-feed'
# — never a CSV import or anything logged by hand), and only those published
# inside the window the feed still covers. A film that scrolled out of the feed
# is out of scope permanently, so removing it on Letterboxd will not remove it
# here.
LETTERBOXD_FEED_DELETE=
