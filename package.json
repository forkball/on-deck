{
  "name": "on-deck",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "NODE_ENV=development node --env-file-if-exists=.env --watch --import remix/node-tsx server.ts",
    "start": "npm run db:migrate && NODE_ENV=production node --env-file-if-exists=.env --import remix/node-tsx server.ts",
    "test": "NODE_ENV=test node --env-file-if-exists=.env --import remix/node-tsx --test",
    "typecheck": "tsc --noEmit",
    "db:up": "docker compose up -d && docker compose exec -T postgres pg_isready -U ondeck -d ondeck",
    "db:down": "docker compose down",
    "db:migrate": "node --env-file-if-exists=.env --import remix/node-tsx db/migrate.ts up",
    "db:migrate:down": "node --env-file-if-exists=.env --import remix/node-tsx db/migrate.ts down"
  },
  "engines": {
    "node": ">=24.3.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "pg": "^8.22.0",
    "remix": "^3.0.0-beta.5"
  },
  "devDependencies": {
    "@types/node": "latest",
    "@types/pg": "^8.20.0",
    "typescript": "latest"
  }
}
